{
 "total": 120.587,
 "chunks": [
  {
   "file": 1,
   "k": 0,
   "start": 0.3,
   "end": 1.736,
   "text": "Bali tohoo gai"
  },
  {
   "file": 1,
   "k": 1,
   "start": 2.136,
   "end": 3.674,
   "text": "kya ap janti ho?"
  },
  {
   "file": 1,
   "k": 2,
   "start": 4.074,
   "end": 6.668,
   "text": "Bhagwaan ki Diwali abhi baaki hai."
  },
  {
   "file": 2,
   "k": 0,
   "start": 6.868,
   "end": 8.028,
   "text": "बहुद ताएं पहले,"
  },
  {
   "file": 2,
   "k": 1,
   "start": 8.148,
   "end": 9.861,
   "text": "तारका सुरके तीन भेटे ते,"
  },
  {
   "file": 2,
   "k": 2,
   "start": 9.981,
   "end": 10.832,
   "text": "तारकाक्ष,"
  },
  {
   "file": 2,
   "k": 3,
   "start": 10.952,
   "end": 11.79,
   "text": "कम्लाक्ष,"
  },
  {
   "file": 2,
   "k": 4,
   "start": 11.91,
   "end": 12.93,
   "text": "और विद्यून्माली,"
  },
  {
   "file": 2,
   "k": 5,
   "start": 13.05,
   "end": 15.683,
   "text": "उनके पास तीन उड़्ती हूँई सिटीस ती,"
  },
  {
   "file": 2,
   "k": 7,
   "start": 15.803,
   "end": 17.49,
   "text": "एक गोल्ड की स्वर्ग में,"
  },
  {
   "file": 2,
   "k": 8,
   "start": 18.04,
   "end": 19.874,
   "text": "एक सिल्वर की स्काय में,"
  },
  {
   "file": 2,
   "k": 9,
   "start": 20.424,
   "end": 21.623,
   "text": "और एक आवरन की"
  },
  {
   "file": 2,
   "k": 10,
   "start": 21.773,
   "end": 22.471,
   "text": "और्द पर."
  },
  {
   "file": 3,
   "k": 0,
   "start": 22.671,
   "end": 24.889,
   "text": "अर उनके पाज ता एक वर्दान"
  },
  {
   "file": 3,
   "k": 1,
   "start": 25.009,
   "end": 26.329,
   "text": "ये तीनो से टीर्स,"
  },
  {
   "file": 3,
   "k": 2,
   "start": 26.449,
   "end": 29.755,
   "text": "ताुजन यहर्स में सिर्फ एक बार एक लाईन में आंगे,"
  },
  {
   "file": 3,
   "k": 3,
   "start": 29.875,
   "end": 32.576,
   "text": "और सिर्फ एक ही टीर्से टिस्ट्राइ हो सकेंगी."
  },
  {
   "file": 4,
   "k": 0,
   "start": 32.776,
   "end": 35.119,
   "text": "3 दर्दर्स, 3 सीपीज"
  },
  {
   "file": 4,
   "k": 1,
   "start": 35.269,
   "end": 36.123,
   "text": "एक तीर."
  },
  {
   "file": 5,
   "k": 0,
   "start": 36.373,
   "end": 37.917,
   "text": "मतलप एंपास्टिबल,"
  },
  {
   "file": 5,
   "k": 1,
   "start": 38.217,
   "end": 39.899,
   "text": "अनलिस आप हो."
  },
  {
   "file": 6,
   "k": 0,
   "start": 40.249,
   "end": 43.088,
   "text": "बना हिस्ट्री का सब से बड़ा रद,"
  },
  {
   "file": 6,
   "k": 1,
   "start": 43.468,
   "end": 44.834,
   "text": "आर्थ बनी रद,"
  },
  {
   "file": 6,
   "k": 2,
   "start": 45.214,
   "end": 47.393,
   "text": "सन और मून बने वील्स,"
  },
  {
   "file": 6,
   "k": 3,
   "start": 47.773,
   "end": 49.501,
   "text": "ब्रम्माजी बने सार्थी,"
  },
  {
   "file": 6,
   "k": 4,
   "start": 49.881,
   "end": 51.875,
   "text": "मेरु मांटेन बना धनुश,"
  },
  {
   "file": 6,
   "k": 5,
   "start": 52.255,
   "end": 54.075,
   "text": "वासुकि नाग बने डोरी,"
  },
  {
   "file": 6,
   "k": 6,
   "start": 54.455,
   "end": 56.53,
   "text": "और तीर बने खुद विश्नुजी."
  },
  {
   "file": 6,
   "k": 7,
   "start": 56.91,
   "end": 59.386,
   "text": "उसकी पोईंट पर थे, अगनी देव."
  },
  {
   "file": 7,
   "k": 0,
   "start": 59.686,
   "end": 62.284,
   "text": "जब तीनो सिटीस एक लाईन मे आई,"
  },
  {
   "file": 7,
   "k": 1,
   "start": 63.984,
   "end": 65.79,
   "text": "महदेव ने दनुष उठाया"
  },
  {
   "file": 7,
   "k": 2,
   "start": 66.29,
   "end": 67.845,
   "text": "और एक ही तीर चला,"
  },
  {
   "file": 7,
   "k": 3,
   "start": 68.145,
   "end": 69.013,
   "text": "इसलिये"
  },
  {
   "file": 7,
   "k": 4,
   "start": 69.193,
   "end": 71.056,
   "text": "उने गयते है, Tripurari."
  },
  {
   "file": 7,
   "k": 5,
   "start": 71.236,
   "end": 72.442,
   "text": "तीन पुरो"
  },
  {
   "file": 7,
   "k": 6,
   "start": 72.622,
   "end": 75.082,
   "text": "मतलप सिटीस का अंथ करने वाले."
  },
  {
   "file": 8,
   "k": 0,
   "start": 75.532,
   "end": 77.004,
   "text": "इतनी बडी जीट हो,"
  },
  {
   "file": 8,
   "k": 1,
   "start": 77.124,
   "end": 78.727,
   "text": "तो सेलिप्रेशन तो बनता है ना?"
  },
  {
   "file": 8,
   "k": 2,
   "start": 78.847,
   "end": 79.534,
   "text": "वेन्यू,"
  },
  {
   "file": 8,
   "k": 3,
   "start": 79.734,
   "end": 81.01,
   "text": "महादेव की नगरी,"
  },
  {
   "file": 8,
   "k": 4,
   "start": 81.13,
   "end": 81.85,
   "text": "काषी,"
  },
  {
   "file": 8,
   "k": 5,
   "start": 82.4,
   "end": 83.009,
   "text": "देट,"
  },
  {
   "file": 8,
   "k": 6,
   "start": 83.209,
   "end": 84.295,
   "text": "कारतिख पुर्नमा,"
  },
  {
   "file": 8,
   "k": 7,
   "start": 84.845,
   "end": 86.788,
   "text": "चन्त्र देव लाए कमप्लीक मुन,"
  },
  {
   "file": 8,
   "k": 8,
   "start": 87.138,
   "end": 89.276,
   "text": "अगनी देव ने जलाए लाए डिये,"
  },
  {
   "file": 8,
   "k": 9,
   "start": 89.396,
   "end": 91.107,
   "text": "वायु देव ने प्रमिस किया,"
  },
  {
   "file": 8,
   "k": 10,
   "start": 91.227,
   "end": 92.982,
   "text": "आज एक भी दिया नहीं भुजेगा।"
  },
  {
   "file": 9,
   "k": 0,
   "start": 93.182,
   "end": 94.426,
   "text": "देवता है,"
  },
  {
   "file": 9,
   "k": 1,
   "start": 94.566,
   "end": 95.93,
   "text": "की गार्ट पे विमान,"
  },
  {
   "file": 9,
   "k": 2,
   "start": 96.07,
   "end": 98.967,
   "text": "मतलव, Vip rides की पार्किंग फुल हो गई."
  },
  {
   "file": 10,
   "k": 0,
   "start": 99.417,
   "end": 100.269,
   "text": "कहते हैं,"
  },
  {
   "file": 10,
   "k": 1,
   "start": 100.449,
   "end": 104.804,
   "text": "इसी रात, देवता खोट काशी के गाटों पर दिवाली मनाने उतरते हैं."
  },
  {
   "file": 10,
   "k": 2,
   "start": 105.104,
   "end": 107.577,
   "text": "इसलिये इसे कहते हैं, देव दिपावनी,"
  },
  {
   "file": 10,
   "k": 3,
   "start": 107.757,
   "end": 109.513,
   "text": "देवतां की दिवाली."
  },
  {
   "file": 10,
   "k": 4,
   "start": 109.793,
   "end": 111.813,
   "text": "ये आती हैं दिवाली के बाद,"
  },
  {
   "file": 10,
   "k": 5,
   "start": 111.993,
   "end": 113.166,
   "text": "Kartik Purnima को."
  },
  {
   "file": 10,
   "k": 6,
   "start": 113.346,
   "end": 116.034,
   "text": "और इसी दिन हैं, गुरुनानक जंती भी."
  },
  {
   "file": 10,
   "k": 7,
   "start": 116.214,
   "end": 118.267,
   "text": "बार, 24 नेवमबर को"
  },
  {
   "file": 10,
   "k": 8,
   "start": 118.447,
   "end": 120.287,
   "text": "एक दिया आप दिजलाना."
  }
 ]
}